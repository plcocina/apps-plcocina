rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Fase 2A: todas las colecciones administrativas son de acceso exclusivo
    // para el backend mediante Firebase Admin SDK. Los SDK de servidor se
    // autorizan con IAM y no dependen de estas reglas.
    match /users/{document=**} {
      allow read, write: if false;
    }

    match /applications/{document=**} {
      allow read, write: if false;
    }

    match /applicationUniqueKeys/{document=**} {
      allow read, write: if false;
    }

    match /accessGrants/{document=**} {
      allow read, write: if false;
    }

    match /invitations/{document=**} {
      allow read, write: if false;
    }

    match /auditEvents/{document=**} {
      allow read, write: if false;
    }

    // Denegación predeterminada para cualquier colección futura hasta que
    // exista una política explícita, revisada y probada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
